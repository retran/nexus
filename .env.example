# ============================================================================
# Environment Configuration for Nexus (Development)
# ============================================================================
#
# DO NOT COMMIT THIS FILE TO VERSION CONTROL!
#
# This file contains secrets and credentials for the Nexus deployment.
# All values marked as "auto-generated" will be filled by scripts/generate-env.sh
#
# Philosophy: Secrets are stored in HashiCorp Vault for security.
# This file contains ONLY the secrets needed for initial bootstrap and the
# Kratos UI (which will be removed in the future).
#
# Usage:
#   1. Run: ./scripts/generate-env.sh
#   2. Run: task vault:secrets:seed  (seeds secrets into Vault)
#   3. Configure optional OAuth credentials (KRATOS_GOOGLE_*)
#   4. Run: docker compose up
# ============================================================================

# ----------------------------------------------------------------------------
# Secrets for Bootstrap (seeded into Vault)
# ----------------------------------------------------------------------------
# These secrets are generated once and then uploaded to Vault.
# Services read them from Vault at runtime, NOT from this file.

# Database Credentials
# Auto-generated by scripts/generate-env.sh
# Stored in Vault: kv/shared/postgres
POSTGRES_PASSWORD=SUPER_SECRET_PASSWORD

# Redis Credentials
# Auto-generated by scripts/generate-env.sh
# Stored in Vault: kv/shared/redis
REDIS_PASSWORD=redis_password

# ----------------------------------------------------------------------------
# Ory Kratos - Authentication Service
# ----------------------------------------------------------------------------
# Encryption secrets for Kratos (must be exactly 32 characters)
# Auto-generated by scripts/generate-env.sh
# Stored in Vault: kv/services/kratos/encryption
KRATOS_COOKIE_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS
KRATOS_CIPHER_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS

# Google OAuth 2.0 Credentials (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google sign-in
# Stored in Vault: kv/services/kratos/google-oidc (if provided)
KRATOS_GOOGLE_CLIENT_ID=
KRATOS_GOOGLE_CLIENT_SECRET=

# Webhook secret for Kratos callbacks to system service
# Auto-generated by scripts/generate-env.sh
# Stored in Vault: kv/shared/webhook
KRATOS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Oathkeeper shared secret for downstream service authentication
# Auto-generated by scripts/generate-env.sh
# Stored in Vault: kv/shared/oathkeeper
OATHKEEPER_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ----------------------------------------------------------------------------
# Kratos Selfservice UI (Temporary - will be removed)
# ----------------------------------------------------------------------------
# Session and CSRF protection secrets for Kratos UI
# Auto-generated by scripts/generate-env.sh
# These remain in env file for now since Kratos UI will be deprecated
KRATOS_UI_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_COOKIE
KRATOS_UI_CSRF_COOKIE_NAME=__HOST-nexus_csrf
KRATOS_UI_CSRF_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_CSRF

# Unsplash API Credentials (Optional)
# Get from: https://unsplash.com/developers
# Stored in Vault: kv/services/photos/unsplash (if provided)
UNSPLASH_ACCESS_KEY=

# ============================================================================
# How secrets are used:
#
# 1. Generate this file: ./scripts/generate-env.sh
# 2. Seed secrets to Vault: task vault:secrets:seed
# 3. Services load secrets from Vault at startup:
#    - Go services: Use internal/config/vault.go helpers
#    - Kratos: Uses init container to load from Vault into env file
# 4. Vault structure:
#    - kv/shared/*: Secrets used by multiple services
#    - kv/services/<service>/*: Service-specific secrets
# ============================================================================
