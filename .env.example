# .env - Environment Configuration
# DO NOT COMMIT THIS FILE TO VERSION CONTROL!
#
# This file contains environment variables for the Nexus deployment.
# For local development, create docker-compose.override.yaml to override
# production settings with hot reload and exposed ports.

# --- PostgreSQL Configuration ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=SUPER_SECRET_PASSWORD
POSTGRES_DB=nexus_db
DATABASE_URL=postgres://admin:SUPER_SECRET_PASSWORD@postgres:5432/nexus_db?sslmode=disable

# --- Redis Configuration ---
REDIS_PASSWORD=redis_password

# --- Docker Compose Project Name ---
COMPOSE_PROJECT_NAME=nexus

# --- Traefik Configuration ---
# Primary domain for local development
DOMAIN=nexus.local

# --- Ory Kratos Configuration ---
# Database connection string for Kratos
DSN=postgres://admin:SUPER_SECRET_PASSWORD@postgres:5432/kratos_db?sslmode=disable&max_conns=20&max_idle_conns=4

# Secrets for cookie and cipher encryption (generate with: openssl rand -hex 32)
# IMPORTANT: These are auto-generated by scripts/generate-env.sh
KRATOS_COOKIE_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS
KRATOS_CIPHER_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS

# Kratos Public API Configuration
KRATOS_PUBLIC_BASE_URL=http://auth.nexus.local
KRATOS_ADMIN_URL=http://kratos:4434

# CORS Configuration for Kratos Public API
KRATOS_CORS_ALLOWED_ORIGINS=http://nexus.local,http://auth.nexus.local,http://api.nexus.local

# Selfservice URLs
KRATOS_DEFAULT_BROWSER_RETURN_URL=http://nexus.local/
KRATOS_ALLOWED_RETURN_URLS=http://nexus.local,http://auth.nexus.local

# Kratos UI URLs for flows
KRATOS_ERROR_UI_URL=http://auth.nexus.local/error
KRATOS_SETTINGS_UI_URL=http://auth.nexus.local/settings
KRATOS_RECOVERY_UI_URL=http://auth.nexus.local/recovery
KRATOS_VERIFICATION_UI_URL=http://auth.nexus.local/verification
KRATOS_LOGIN_UI_URL=http://auth.nexus.local/login
KRATOS_REGISTRATION_UI_URL=http://auth.nexus.local/registration
KRATOS_LOGOUT_AFTER_RETURN_URL=http://auth.nexus.local/login
KRATOS_VERIFICATION_AFTER_RETURN_URL=http://nexus.local/
KRATOS_LOGIN_AFTER_RETURN_URL=http://nexus.local/

# Google OAuth Configuration (Optional)
# Get credentials from: https://console.cloud.google.com/apis/credentials
KRATOS_GOOGLE_CLIENT_ID=
KRATOS_GOOGLE_CLIENT_SECRET=

# Webhook Configuration for Kratos -> System Service
KRATOS_WEBHOOK_LOGIN_URL=http://system:8082/webhooks/kratos/login
KRATOS_WEBHOOK_REGISTRATION_URL=http://system:8082/webhooks/kratos/registration
# Webhook secret (auto-generated by scripts/generate-env.sh)
KRATOS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Courier/SMTP Configuration
KRATOS_COURIER_SMTP_URI=smtps://test:test@mailhog:1025/?skip_ssl_verify=true

# Logging Configuration
KRATOS_LOG_LEVEL=debug
KRATOS_LOG_LEAK_SENSITIVE=true

# --- Kratos Selfservice UI Configuration ---
# Internal Kratos API URL (container-to-container communication)
KRATOS_UI_PUBLIC_URL=http://kratos:4433
# Browser URL for Kratos (where users are redirected)
KRATOS_UI_BROWSER_URL=http://auth.nexus.local
# Cookie secret for session management (min 8 chars, auto-generated by scripts/generate-env.sh)
KRATOS_UI_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_COOKIE
# CSRF cookie name (use __HOST- prefix for security)
KRATOS_UI_CSRF_COOKIE_NAME=__HOST-nexus_csrf
# CSRF cookie secret (min 8 chars, auto-generated by scripts/generate-env.sh)
KRATOS_UI_CSRF_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_CSRF

# --- Frontend Configuration ---
# API endpoint URL (via Traefik)
API_URL=https://api.${DOMAIN}

# Auth endpoint URL (Kratos)
AUTH_URL=https://auth.${DOMAIN}

# --- Webhook Configuration ---
# Secret for validating webhooks from Kratos (generate with: openssl rand -hex 32)
KRATOS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Shared secret between Oathkeeper and downstream services (generate with: openssl rand -hex 32)
OATHKEEPER_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# After updating values, run `task secrets:seed` to sync them into Vault KV for development.

# --- Ory Keto Configuration ---
# Database connection for Keto
KETO_DSN=postgres://admin:SUPER_SECRET_PASSWORD@postgres:5432/keto_db?sslmode=disable&max_conns=20&max_idle_conns=4

# --- Ory Logging Configuration ---
# Logging for Kratos, Keto, Oathkeeper (dev: debug/text/true, prod: info/json/false)
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_LEAK_SENSITIVE=true

# --- SMTP Configuration ---
# Dev: MailHog (fake SMTP), Prod: Real SMTP server
SMTP_CONNECTION_URI=smtps://test:test@mailhog:1025/?skip_ssl_verify=true

# --- Backend Services Configuration ---
# Data API (GraphQL) endpoint for gateway and worker
DATA_API_ENDPOINT=http://data:8081/graphql

# Temporal configuration for system service and worker
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexus-task-queue

# PostgreSQL connection for backend services (data service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# Redis connection for gateway
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Gateway configuration
ALLOWED_ORIGINS=http://nexus.local,https://nexus.local
FRONTEND_URL=http://nexus.local
SYSTEM_API_ENDPOINT=http://system:8083
