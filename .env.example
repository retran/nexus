# ============================================================================
# Environment Configuration for Nexus (Development)
# ============================================================================
#
# DO NOT COMMIT THIS FILE TO VERSION CONTROL!
#
# This file contains secrets and credentials for the Nexus deployment.
# All values marked as "auto-generated" will be filled by scripts/generate-env.sh
#
# Philosophy: This file contains ONLY secrets. All URLs, hosts, ports, and
# other non-secret configuration are in static config files (*.dev.yml) or
# hardcoded in docker-compose.yaml for development.
#
# Usage:
#   1. Run: ./scripts/generate-env.sh
#   2. Configure optional OAuth credentials (KRATOS_GOOGLE_*)
#   3. Run: docker compose up
# ============================================================================

# ----------------------------------------------------------------------------
# Database Credentials
# ----------------------------------------------------------------------------
# PostgreSQL password - used across all services
# Auto-generated by scripts/generate-env.sh
POSTGRES_PASSWORD=SUPER_SECRET_PASSWORD

# ----------------------------------------------------------------------------
# Redis Credentials
# ----------------------------------------------------------------------------
# Redis authentication password
# Auto-generated by scripts/generate-env.sh
REDIS_PASSWORD=redis_password

# ----------------------------------------------------------------------------
# Ory Kratos - Authentication Service
# ----------------------------------------------------------------------------
# Encryption secrets for Kratos (must be exactly 32 characters)
# Auto-generated by scripts/generate-env.sh
KRATOS_COOKIE_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS
KRATOS_CIPHER_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS

# Google OAuth 2.0 Credentials (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google sign-in
KRATOS_GOOGLE_CLIENT_ID=
KRATOS_GOOGLE_CLIENT_SECRET=

# Webhook secret for Kratos callbacks to system service
# Auto-generated by scripts/generate-env.sh
KRATOS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ----------------------------------------------------------------------------
# Kratos Selfservice UI
# ----------------------------------------------------------------------------
# Session and CSRF protection secrets for Kratos UI
# Auto-generated by scripts/generate-env.sh
KRATOS_UI_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_COOKIE
KRATOS_UI_CSRF_COOKIE_NAME=__HOST-nexus_csrf
KRATOS_UI_CSRF_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_CSRF

# ----------------------------------------------------------------------------
# Ory Oathkeeper - Authorization Gateway
# ----------------------------------------------------------------------------
# Shared secret between Oathkeeper and downstream services
# Auto-generated by scripts/generate-env.sh
OATHKEEPER_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ============================================================================
# Note: After updating secrets, run `task secrets:seed` to sync them into
# Vault KV for development.
# ============================================================================
