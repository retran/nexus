# .env.dev.example - Development Environment Configuration Template
# Copy this to .env and fill in your values. DO NOT COMMIT .env!
#
# Usage: cp .env.dev.example .env
#
# NOTE: This configuration is for DEVELOPMENT ONLY.
# Production configuration will use:
# - .env.prod.example as template
# - Actual domains with HTTPS/TLS
# - Cloudflare Tunnel for external access

# --- PostgreSQL Configuration ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=SUPER_SECRET_PASSWORD
POSTGRES_DB=nexus_db

# --- Redis Configuration ---
REDIS_PASSWORD=redis_password

# --- Docker Compose Project Name ---
COMPOSE_PROJECT_NAME=nexus

# --- Traefik Configuration ---
# Domain for local development
DOMAIN=nexus.local

# --- Ory Kratos Configuration ---
# Database connection for Kratos (uses POSTGRES_PASSWORD from above)
DSN=postgres://admin:${POSTGRES_PASSWORD}@postgres:5432/kratos_db?sslmode=disable&max_conns=20&max_idle_conns=4

# Secrets for cookie and cipher encryption (generate with: openssl rand -hex 32)
# IMPORTANT: Kratos reads these via environment variables with specific naming:
# - SECRETS_COOKIE maps to secrets.cookie in kratos.yml
# - SECRETS_CIPHER maps to secrets.cipher in kratos.yml
# See: https://www.ory.sh/docs/ecosystem/configuring
KRATOS_COOKIE_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS
KRATOS_CIPHER_SECRET=CHANGEME_SECRET_EXACTLY_32CHARSS

# Public URLs for Kratos
KRATOS_PUBLIC_URL=http://auth.nexus.local
KRATOS_ADMIN_URL=http://kratos:4434

# Self-service UI URLs
KRATOS_SELFSERVICE_UI_URL=http://auth.nexus.local

# Allowed return URLs after authentication
KRATOS_SELFSERVICE_ALLOWED_RETURN_URLS=http://nexus.local,http://api.nexus.local

# --- Google OAuth Configuration ---
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Apple OAuth Configuration (optional) ---
APPLE_CLIENT_ID=YOUR_APPLE_CLIENT_ID
APPLE_CLIENT_SECRET=YOUR_APPLE_CLIENT_SECRET
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID

# --- Backend JWT Configuration ---
# Secret for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ISSUER=nexus
JWT_AUDIENCE=nexus-users

# --- Kratos Selfservice UI Configuration ---
# Cookie secret for session management (min 8 chars, generate with: openssl rand -hex 32)
COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_COOKIE
# CSRF cookie name (use __HOST- prefix for security)
CSRF_COOKIE_NAME=__HOST-nexus_csrf
# CSRF cookie secret (min 8 chars, generate with: openssl rand -hex 32)
CSRF_COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_FOR_CSRF

# --- Frontend Configuration ---
# API endpoint URL (via Traefik)
VITE_API_URL=http://api.nexus.local

# Auth endpoint URL (Kratos)
VITE_AUTH_URL=http://auth.nexus.local

# --- Webhook Configuration ---
# Secret for validating webhooks from Kratos (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Shared secret between Oathkeeper and downstream services (generate with: openssl rand -hex 32)
OATHKEEPER_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# After updating values, run `task secrets:seed` to sync them into Vault KV for development.

# --- Vault Configuration ---
# Root token for Vault (dev mode only, generate with: openssl rand -hex 32)
VAULT_ROOT_TOKEN=dev-root-token
VAULT_ADDR=http://vault:8200

# --- Vault OIDC Configuration ---
VAULT_OIDC_CLIENT_ID=vault-dev-ui
VAULT_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Optional overrides (defaults work for docker-compose network)
#VAULT_OIDC_DISCOVERY_URL=http://kratos:4433/.well-known/openid-configuration
#VAULT_OIDC_ISSUER=http://auth.nexus.local
#VAULT_OIDC_REDIRECT_URIS=http://localhost:8200/ui/vault/auth/oidc/oidc/callback,http://localhost:8200/oidc/callback

# --- Ory Keto Configuration ---
# Database connection for Keto (uses POSTGRES_PASSWORD from above)
KETO_DSN=postgres://admin:${POSTGRES_PASSWORD}@postgres:5432/keto_db?sslmode=disable&max_conns=20&max_idle_conns=4

# --- SSO OIDC Clients Configuration ---
# Temporal UI OAuth2 Client (for SSO)
TEMPORAL_OIDC_CLIENT_ID=dev-temporal-ui
TEMPORAL_OIDC_CLIENT_SECRET=dev-temporal-secret-change-in-production

# Grafana OAuth2 Client (for future SSO)
GRAFANA_OIDC_CLIENT_ID=dev-grafana-ui
GRAFANA_OIDC_CLIENT_SECRET=dev-grafana-secret-change-in-production

# --- Vault AppRole Credentials for Temporal ---
# Generated by vault:bootstrap task - DO NOT COMMIT
TEMPORAL_ROLE_ID=
TEMPORAL_SECRET_ID=
